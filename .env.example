# Copy to .env for local development. These values are disposable and local-only.
POSTGRES_DB=deletion
POSTGRES_USER=postgres
POSTGRES_PASSWORD=local-only-owner
DELETION_WORKER_PASSWORD=local-only-worker
DATABASE_URL=host=postgres port=5432 dbname=deletion user=deletion_worker password=local-only-worker sslmode=disable
AUDIT_SALT=local-development-only-salt-32-bytes-minimum
S3_BUCKET=deletion-objects
DB_QUEUE_NAME=db-deletion-queue
DB_DLQ_NAME=db-deletion-dlq
S3_QUEUE_NAME=s3-deletion-queue
S3_DLQ_NAME=s3-deletion-dlq
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
